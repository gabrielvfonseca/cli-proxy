# CLIProxyAPI Hub Environment
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# --- Compose ---
COMPOSE_PROJECT_NAME=cliproxyapi

# --- CLIProxyAPI server ---
CLIPROXY_HOST=0.0.0.0
CLIPROXY_PORT=8317

# --- Access key (what clients send: Claude Code, Codex, OpenCode, Zed) ---
# Generate a strong random string, e.g.: openssl rand -hex 32
CLIPROXY_ACCESS_KEY=change-me-access-key

# --- Management key (protects /management.html panel) ---
# Generate a strong random string, e.g.: openssl rand -hex 32
CLIPROXY_MANAGEMENT_KEY=change-me-management-key

# --- Cloudflare Tunnel URL ---
# Set this after your tunnel is created, e.g. https://abc123.cloudflare.com
TUNNEL_URL=https://your-tunnel-url.example.com

# --- Data directory (persisted auth state) ---
DATA_DIR=./data
